# Secrets and local configuration
.env
.env.*
!.env.example
# Real DB credentials. Glob covers backups and profile variants; the *.example
# template is the only one that may be committed.
backend/configs/*_db_config.yaml*
!backend/configs/*.example.yaml

# Agent run artifacts.
# Scoped to the directories that actually collect generated output. A blanket
# `*.png` rule previously ignored the ten agent icons under
# frontend/assets/icons/ that Dashboard.jsx imports.
output/
DOM_output/
chrome_profile/
screenshots/
*.pdf

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
env/
venv/
.venv/

# Node
node_modules/
dist/
dist-ssr/
*.local

# IDE and editor
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
